# Optional: credentials can also be entered on the login screen
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=production

# Leave blank on Vercel — auto-detected from the request host
APP_BASE_URL=
QBO_REDIRECT_URI=

# Encrypts stored credentials/tokens; also used by morning cron auth
APP_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-a-long-random-string

# true = sample data when no credentials are configured
DEMO_MODE=false
