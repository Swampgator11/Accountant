# QuickBooks Online (Intuit Developer app)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/auth/callback
QBO_ENVIRONMENT=sandbox

# App
