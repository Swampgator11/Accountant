# QuickBooks Online (set these in Vercel project env, same pattern as AnarchySoftware)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=production
APP_BASE_URL=https://your-accountant.vercel.app
QBO_REDIRECT_URI=https://your-accountant.vercel.app/api/auth/callback

# App login gate (email/password), like AnarchySoftware /login
AUTH_EMAIL=john@anarchyaleworks.com
AUTH_PASSWORD=change-me

# Encrypts stored tokens; also used by morning cron auth
APP_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-a-long-random-string

# true = sample data when no QBO credentials are configured
DEMO_MODE=false
